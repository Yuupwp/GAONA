# Solo ejemplos. npm run web:configurar copia esta plantilla sin sobrescribir .env.
# Node.js 24. Completar personalmente; nunca publicar api/.env.
NODE_ENV=development

# ESCRITORIO: obligatorias para Prisma y JWT (web.ts no necesita JWT_SECRET).
# Reemplazar los valores ficticios por conexiones autorizadas. No ejecutar migraciones.
DATABASE_URL=postgresql://usuario_ejemplo:clave_ejemplo@127.0.0.1:5432/gaona_ejemplo
DIRECT_URL=postgresql://usuario_ejemplo:clave_ejemplo@127.0.0.1:5432/gaona_ejemplo
# Obligatoria para escritorio: secreto aleatorio privado, al menos 32 bytes.
JWT_SECRET=
# Opcionales; Electron usa 127.0.0.1:3001.
DESKTOP_HOST=127.0.0.1
PORT=3001

# WEB INDEPENDIENTE: escoger postgres o data-api y completar SOLO ese modo.
WEB_HOST=127.0.0.1
WEB_PORT=3000
SOLICITUD_STORAGE=postgres
# PostgreSQL web: obligatorias en modo postgres. Rol restringido, separado del escritorio.
# Para conexión remota usar sslmode=require&sslaccept=strict&sslcert=ruta/CA-oficial.crt.
# web:configurar no inicia servicios. web:verificar exige proyecto/rol autorizados.
WEB_DATABASE_URL=
WEB_DATABASE_ROLE=

# Obligatorias en persistencia web: dos claves estables de 64 caracteres hexadecimales.
# No sustituir claves existentes. web:claves muestra la ayuda del flujo Data API.
SOLICITUD_IDEMPOTENCY_KEY=
SOLICITUD_PDF_KEY=

# Alternativa data-api: SOLICITUD_STORAGE=data-api y estas cinco variables obligatorias.
# Usar proyecto, cuenta técnica y UID autorizados por los scripts actuales.
# Nunca usar service_role. Las variables de este bloque no configuran web.ts/PostgreSQL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_EMAIL=
SUPABASE_AUTH_PASSWORD=
SUPABASE_AUTH_UID=

# Correo y WhatsApp apagados por defecto; no se envía nada al configurar.
MAIL_ENABLED=false
WHATSAPP_ENABLED=false
# SMTP opcional: descomentar y completar TODO el bloque solo si se autoriza correo real.
# No dejar claves SMTP vacías activas: el validador web exige un bloque coherente.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario_ejemplo
# SMTP_PASSWORD=clave_ejemplo
# SMTP_FROM=notificaciones@example.invalid

# Recuperación de empleados (Resend), opcional para el resto de la aplicación.
# RESEND_API_KEY=clave_de_ejemplo
# EMAIL_FROM=notificaciones@example.invalid
# RESET_PASSWORD_URL=http://127.0.0.1:5500/restablecer.html
