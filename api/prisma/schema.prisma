generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Rol {
  id       String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre   String    @unique
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id                     String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  idRol                  String
  nombre                 String
  apellido               String
  usuario                String                  @unique
  passwordHash           String
  correo                 String                  @unique
  telefono               String?
  activo                 Boolean                 @default(true)
  creadoEn               DateTime                @default(now())
  actualizadoEn          DateTime                @default(now()) @updatedAt
  citas                  Cita[]
  cotizaciones           Cotizacion[]
  historialPedidos       HistorialPedido[]
  movimientos            MovimientoInventario[]
  pagosRegistrados       Pago[]
  solicitudesAsignadas   Solicitud[]
  tokensRestablecimiento TokenRestablecimiento[]
  rol                    Rol                     @relation(fields: [idRol], references: [id])

  @@index([idRol], map: "usuarios_idrol_idx")
  @@map("usuarios")
}

model Cliente {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre        String
  apellido      String
  direccion     String?
  telefono      String
  correo        String?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @default(now()) @updatedAt
  pedidos       Pedido[]
  solicitudes   Solicitud[]

  @@index([telefono])
  @@index([correo])
  @@map("clientes")
}

model Categoria {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre    String     @unique
  productos Producto[]

  @@map("categorias")
}

model Producto {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  idCategoria        String
  tipo               TipoProducto        @default(PRODUCTO)
  nombre             String
  descripcion        String?
  precioDesde        Decimal             @db.Decimal(12, 2)
  imagenUrl          String?
  activo             Boolean             @default(true)
  creadoEn           DateTime            @default(now())
  actualizadoEn      DateTime            @default(now()) @updatedAt
  cotizacionDetalles CotizacionDetalle[]
  inventario         Inventario?
  categoria          Categoria           @relation(fields: [idCategoria], references: [id])
  solicitudDetalles  SolicitudDetalle[]

  @@index([nombre])
  @@index([idCategoria], map: "productos_idcategoria_idx")
  @@map("productos")
}

model Inventario {
  id            String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  idProducto    String                 @unique
  existencia    Int                    @default(0)
  minimo        Int                    @default(0)
  actualizadoEn DateTime               @default(now()) @updatedAt
  producto      Producto               @relation(fields: [idProducto], references: [id])
  movimientos   MovimientoInventario[]

  @@map("inventario")
}

model MovimientoInventario {
  id           String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  idInventario String
  idUsuario    String
  idPedido     String?
  tipo         TipoMovimiento
  cantidad     Int
  motivo       String?
  fecha        DateTime       @default(now())
  inventario   Inventario     @relation(fields: [idInventario], references: [id])
  pedido       Pedido?        @relation(fields: [idPedido], references: [id])
  usuario      Usuario        @relation(fields: [idUsuario], references: [id])

  @@index([idInventario], map: "movimientos_inventario_idinventario_idx")
  @@index([idPedido], map: "movimientos_inventario_idpedido_idx")
  @@map("movimientos_inventario")
}

model Solicitud {
  id                String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  idCliente         String
  idUsuarioAsignado String?
  origen            OrigenSolicitud    @default(WEB)
  estado            EstadoSolicitud    @default(NUEVA)
  descripcion       String?
  creadoEn          DateTime           @default(now())
  actualizadoEn     DateTime           @default(now()) @updatedAt
  citas             Cita[]
  cotizaciones      Cotizacion[]
  detalles          SolicitudDetalle[]
  cliente           Cliente            @relation(fields: [idCliente], references: [id])
  usuarioAsignado   Usuario?           @relation(fields: [idUsuarioAsignado], references: [id])

  @@index([estado])
  @@index([idCliente], map: "solicitudes_idcliente_idx")
  @@index([idUsuarioAsignado], map: "solicitudes_idusuarioasignado_idx")
  @@map("solicitudes")
}

model SolicitudDetalle {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  idSolicitud   String
  idProducto    String
  cantidad      Int       @default(1)
  medidasAprox  String?
  medidasReales String?
  notas         String?
  producto      Producto  @relation(fields: [idProducto], references: [id])
  solicitud     Solicitud @relation(fields: [idSolicitud], references: [id], onDelete: Cascade)

  @@index([idProducto], map: "solicitud_detalles_idproducto_idx")
  @@index([idSolicitud], map: "solicitud_detalles_idsolicitud_idx")
  @@map("solicitud_detalles")
}

model Cita {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  tipo        TipoCita
  estado      EstadoCita @default(PROGRAMADA)
  idUsuario   String
  idSolicitud String?
  idPedido    String?
  inicio      DateTime
  fin         DateTime
  direccion   String?
  notas       String?
  creadoEn    DateTime   @default(now())
  pedido      Pedido?    @relation(fields: [idPedido], references: [id])
  solicitud   Solicitud? @relation(fields: [idSolicitud], references: [id])
  usuario     Usuario    @relation(fields: [idUsuario], references: [id])

  @@index([idPedido], map: "citas_idpedido_idx")
  @@index([idSolicitud], map: "citas_idsolicitud_idx")
  @@index([idUsuario, inicio, fin], map: "citas_idusuario_inicio_fin_idx")
  @@map("citas")
}

model Cotizacion {
  id                String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  idSolicitud       String
  idUsuario         String
  estado            EstadoCotizacion    @default(BORRADOR)
  subtotal          Decimal             @default(0) @db.Decimal(12, 2)
  iva               Decimal             @default(0) @db.Decimal(12, 2)
  total             Decimal             @default(0) @db.Decimal(12, 2)
  anticipoRequerido Decimal?            @db.Decimal(12, 2)
  vigenciaHasta     DateTime?
  fechaAprobacion   DateTime?
  pdfUrl            String?
  creadoEn          DateTime            @default(now())
  actualizadoEn     DateTime            @default(now()) @updatedAt
  detalles          CotizacionDetalle[]
  solicitud         Solicitud           @relation(fields: [idSolicitud], references: [id])
  usuario           Usuario             @relation(fields: [idUsuario], references: [id])
  pedido            Pedido?

  @@index([estado])
  @@index([idSolicitud], map: "cotizaciones_idsolicitud_idx")
  @@map("cotizaciones")
}

model CotizacionDetalle {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  idCotizacion   String
  idProducto     String?
  concepto       TipoConcepto @default(PRODUCTO)
  descripcion    String
  cantidad       Decimal      @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal      @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(12, 2)
  medidas        String?
  cotizacion     Cotizacion   @relation(fields: [idCotizacion], references: [id], onDelete: Cascade)
  producto       Producto?    @relation(fields: [idProducto], references: [id])

  @@index([idCotizacion], map: "cotizacion_detalles_idcotizacion_idx")
  @@map("cotizacion_detalles")
}

model Pedido {
  id            String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  idCotizacion  String                 @unique
  idCliente     String
  estado        EstadoPedido           @default(EN_PROCESO)
  total         Decimal                @db.Decimal(12, 2)
  creadoEn      DateTime               @default(now())
  actualizadoEn DateTime               @default(now()) @updatedAt
  citas         Cita[]
  entrega       Entrega?
  factura       Factura?
  historial     HistorialPedido[]
  movimientos   MovimientoInventario[]
  pagos         Pago[]
  cliente       Cliente                @relation(fields: [idCliente], references: [id])
  cotizacion    Cotizacion             @relation(fields: [idCotizacion], references: [id])

  @@index([estado])
  @@index([idCliente], map: "pedidos_idcliente_idx")
  @@map("pedidos")
}

model Pago {
  id         String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  idPedido   String
  idUsuario  String
  tipo       TipoPago
  metodo     MetodoPago
  monto      Decimal    @db.Decimal(12, 2)
  referencia String?
  fecha      DateTime   @default(now())
  pedido     Pedido     @relation(fields: [idPedido], references: [id])
  usuario    Usuario    @relation(fields: [idUsuario], references: [id])

  @@index([idPedido], map: "pagos_idpedido_idx")
  @@map("pagos")
}

model Entrega {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  idPedido      String    @unique
  firmaUrl      String?
  nombreRecibe  String?
  fechaFirma    DateTime?
  observaciones String?
  pedido        Pedido    @relation(fields: [idPedido], references: [id])

  @@map("entregas")
}

model Factura {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  idPedido   String   @unique
  folio      String   @unique
  monto      Decimal  @db.Decimal(12, 2)
  fecha      DateTime @default(now())
  archivoUrl String?
  pedido     Pedido   @relation(fields: [idPedido], references: [id])

  @@map("facturas")
}

model HistorialPedido {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  idPedido       String
  idUsuario      String
  estadoAnterior EstadoPedido?
  estadoNuevo    EstadoPedido
  fecha          DateTime      @default(now())
  pedido         Pedido        @relation(fields: [idPedido], references: [id])
  usuario        Usuario       @relation(fields: [idUsuario], references: [id])

  @@index([idPedido], map: "historial_pedidos_idpedido_idx")
  @@map("historial_pedidos")
}

model TokenRestablecimiento {
  id          String    @id @default(uuid())
  idUsuario   String
  tokenHash   String    @unique
  expiraEn    DateTime
  utilizadoEn DateTime?
  creadoEn    DateTime  @default(now())
  usuario     Usuario   @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([idUsuario])
  @@index([expiraEn])
  @@map("tokens_restablecimiento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gaona_web_configuracion {
  id                  Int    @id
  version             Int
  backend_uid         String @db.Uuid
  idempotencia_huella String
  acceso_huella       String
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gaona_web_correos {
  solicitud_id        String              @id
  destinatario        String
  modo                String              @default("simulado")
  estado              String
  intentos            Int                 @default(0) @db.SmallInt
  mensaje_id          String              @unique
  adjunto_sha256      String?
  reserva             String?             @db.Uuid
  vence_reserva       DateTime?           @db.Timestamptz(6)
  codigo_error        String?
  proveedor_id        String?
  respuesta_smtp      Int?
  creado_en           DateTime            @default(now()) @db.Timestamptz(6)
  gaona_web_registros gaona_web_registros @relation(fields: [solicitud_id], references: [solicitud_id], onUpdate: NoAction)

  @@index([creado_en, destinatario], map: "gaona_web_correos_cuota")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gaona_web_documentos {
  solicitud_id        String              @id
  estado              String              @default("pendiente")
  pdf                 Bytes?
  pdf_sha256          String?
  intentos            Int                 @default(0) @db.SmallInt
  reserva             String?             @db.Uuid
  vence_reserva       DateTime?           @db.Timestamptz(6)
  retener_hasta       DateTime            @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  gaona_web_registros gaona_web_registros @relation(fields: [solicitud_id], references: [solicitud_id], onUpdate: NoAction)

  @@index([retener_hasta], map: "gaona_web_documentos_retencion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gaona_web_registros {
  clave                String                @id
  huella               String
  cliente_id           String
  solicitud_id         String                @unique
  origen_huella        String
  datos                Json
  comprobante          Json
  creado_en            DateTime              @default(now()) @db.Timestamptz(6)
  retener_hasta        DateTime              @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  gaona_web_correos    gaona_web_correos?
  gaona_web_documentos gaona_web_documentos?

  @@index([creado_en, origen_huella], map: "gaona_web_registros_cuota")
}

enum EstadoSolicitud {
  NUEVA
  EN_REVISION
  VISITA_PROGRAMADA
  COTIZADA
  CANCELADA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
}

enum EstadoPedido {
  EN_PROCESO
  LISTO_PARA_INSTALAR
  ENTREGADO
  FACTURADO
  CERRADO
  CANCELADO
}

enum TipoCita {
  MEDICION
  ENTREGA
  INSTALACION
}

enum EstadoCita {
  PROGRAMADA
  REALIZADA
  CANCELADA
  REPROGRAMADA
}

enum TipoConcepto {
  PRODUCTO
  MATERIAL
  MANO_OBRA
  FLETE
}

enum TipoPago {
  ANTICIPO
  PARCIAL
  LIQUIDACION
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

enum TipoProducto {
  PRODUCTO
  MATERIAL
  HERRAMIENTA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum OrigenSolicitud {
  WEB
  ESCRITORIO
}
